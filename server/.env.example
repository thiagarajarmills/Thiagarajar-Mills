PORT=5000
# Connection string for your cloud database
DATABASE_URL=postgres://user:password@host:port/database_name?sslmode=require
# Or for local development if you have postgres installed
# DATABASE_URL=postgres://postgres:password@localhost:5432/cotton_mills

# Supabase Authentication and Storage (Get these from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_KEY is the anon public key (can be used for frontend, but backend can also use it for simple operations)
SUPABASE_KEY=your-anon-key
# SUPABASE_SERVICE_KEY is the secret role key (required for uploading files to storage bins without RLS policies getting in the way)
SUPABASE_SERVICE_KEY=your-service-role-key
